export enum TabCommandStatus { none, success, failure }

export struct TabData {
    title: string,
    active: bool,
    selected: bool,
    command-status: TabCommandStatus,
}

export global TabActions {
    callback select-tab(int);
    callback close-tab(int);
    callback new-tab();
}

component CloseButton inherits Rectangle {
    callback clicked();
    in property <bool> hovered;
    in property <TabCommandStatus> command-status;
    private property <bool> show-status: root.command-status != TabCommandStatus.none
        && !root.hovered && !close-touch.has-hover;

    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: root.hovered || close-touch.has-hover ? #ffffff18 : transparent;
    accessible-role: button;
    accessible-label: root.command-status == TabCommandStatus.success
        ? "Close tab (command succeeded)"
        : root.command-status == TabCommandStatus.failure ? "Close tab (command failed)" : "Close tab";

    Text {
        text: "×";
        visible: !root.show-status;
        color: #d7dae0;
        font-size: 1.05rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.show-status : Rectangle {
        width: 10px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: root.command-status == TabCommandStatus.success ? #6488bc : #f5bd56;
        background: root.command-status == TabCommandStatus.success ? #254778 : #e9a229;
    }

    close-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TabButton inherits Rectangle {
    in property <TabData> tab;
    in property <int> tab-index;
    in property <length> assigned-width;
    in property <bool> hovered;
    in property <bool> close-hovered;
    in property <bool> dragging;

    min-width: assigned-width;
    preferred-width: assigned-width;
    max-width: assigned-width;
    height: 100%;
    background: root.dragging
        ? #343a46
        : tab.selected ? #293b55
        : tab.active ? #282c34 : root.hovered || tab-touch.has-hover ? #23272f : #1b1e24;
    border-width: root.dragging || tab.selected ? 1px : 0px;
    border-color: #5ea1ff80;
    accessible-role: AccessibleRole.tab;
    accessible-label: tab.selected ? tab.title + " (selected)" : tab.title;

    tab-touch := TouchArea {
        clicked => { TabActions.select-tab(tab-index); }
    }

    Rectangle {
        x: 0;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: tab.active ? #5ea1ff : transparent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: tab.title;
            color: tab.active ? #f4f6fa : #b8bdc7;
            font-size: 0.9rem;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 24px;
            height: 100%;

            CloseButton {
                y: (parent.height - self.height) / 2;
                hovered: root.close-hovered;
                command-status: tab.command-status;
                clicked => { TabActions.close-tab(tab-index); }
            }
        }
    }
}

export component TabBar inherits Window {
    in property <[TabData]> tabs;
    in property <int> hovered-tab: -1;
    in property <int> hovered-close-tab: -1;
    in property <bool> new-tab-hovered;
    in property <int> dragged-tab: -1;
    in property <int> drop-slot: -1;
    in property <length> tab-width: 184px;

    preferred-width: 800px;
    height: 36px;
    background: #171a1f;
    title: "Alacritty tabs";

    HorizontalLayout {
        spacing: 0;

        for tab[index] in root.tabs: TabButton {
            tab: tab;
            tab-index: index;
            assigned-width: root.tab-width;
            hovered: index == root.hovered-tab;
            close-hovered: index == root.hovered-close-tab;
            dragging: index == root.dragged-tab;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #171a1f;
        }

        Rectangle {
            width: 40px;
            height: 100%;
            background: root.new-tab-hovered || add-touch.has-hover ? #252a32 : #171a1f;
            accessible-role: button;
            accessible-label: "New tab";

            Text {
                text: "+";
                color: #d7dae0;
                font-size: 1.2rem;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            add-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { TabActions.new-tab(); }
            }
        }
    }

    if root.drop-slot >= 0 : Rectangle {
        x: min(root.width - self.width, max(0px, root.drop-slot * root.tab-width - 1px));
        width: 2px;
        height: parent.height;
        background: #5ea1ff;
    }
}

export struct ScrollbarCommandMark {
    y: length,
    status: TabCommandStatus,
}

export component ScrollBarOverlay inherits Window {
    in property <length> thumb-y;
    in property <length> thumb-height: 24px;
    in property <bool> scrollbar-visible;
    in property <bool> hovered;
    in property <bool> dragging;
    in property <[ScrollbarCommandMark]> command-marks;
    callback scroll-requested(float);

    preferred-width: 12px;
    preferred-height: 600px;
    background: transparent;
    title: "Alacritty scrollbar";

    if root.scrollbar-visible : Rectangle {
        x: 3px;
        width: 6px;
        height: 100%;
        border-radius: 3px;
        background: root.hovered ? #ffffff0c : transparent;
    }

    if root.scrollbar-visible : Rectangle {
        x: 3px;
        y: root.thumb-y;
        width: 6px;
        height: root.thumb-height;
        border-radius: 3px;
        background: root.dragging ? #d7dae0c0 : root.hovered ? #d7dae098 : #d7dae068;
        accessible-role: slider;
        accessible-label: "Terminal scrollback";
    }

    for mark in root.command-marks : Rectangle {
        x: 1px;
        y: mark.y;
        width: parent.width - 2px;
        height: 2px;
        border-radius: 1px;
        background: mark.status == TabCommandStatus.failure ? #e9a229
            : mark.status == TabCommandStatus.success ? #5d89c6 : #9baab9;
    }

    scrollbar-touch := TouchArea {
        enabled: root.scrollbar-visible;
        mouse-cursor: pointer;
        clicked => {
            root.scroll-requested(
                root.height > root.thumb-height
                    ? ((self.mouse-y - root.thumb-height / 2)
                        / (root.height - root.thumb-height)).clamp(0, 1)
                    : 0
            );
        }
    }
}

export component CommandMarkTooltip inherits Window {
    in property <string> label;

    preferred-width: 320px;
    preferred-height: 32px;
    background: transparent;

    Rectangle {
        border-radius: 5px;
        border-width: 1px;
        border-color: #526074;
        background: #242a34;
        accessible-role: text;
        accessible-label: root.label;

        Text {
            x: 9px;
            width: parent.width - 18px;
            height: parent.height;
            text: root.label;
            color: #f4f6fa;
            font-size: 0.9rem;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
